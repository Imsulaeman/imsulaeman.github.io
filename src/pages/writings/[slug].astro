---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={`${entry.data.title} — Ilham Maulana Sulaeman`} description={entry.data.description}>
  <main class="container">
    <header class="header">
      <nav class="nav">
        <a href="/" class="nav-name">ilham</a>
        <div class="nav-links">
          <a href="/#projects">projects</a>
          <a href="/writings" class="nav-active">writings</a>
          <a href="/#shapes-me">what shapes me</a>
        </div>
      </nav>
    </header>

    <article class="essay">
      <header class="essay-header">
        <a href="/writings" class="back-link">← writings</a>
        <h1 class="essay-title">{entry.data.title}</h1>
        {entry.data.description && (
          <p class="essay-desc">{entry.data.description}</p>
        )}
        <time class="essay-date" datetime={entry.data.date.toISOString()}>
          {formatDate(entry.data.date)}
        </time>
      </header>

      <div class="essay-body">
        <Content />
      </div>

      <footer class="essay-footer">
        <a href="/writings" class="back-link">← back to writings</a>
      </footer>
    </article>

    <footer class="footer">
      <p>&copy; 2026 Ilham Maulana Sulaeman</p>
    </footer>
  </main>
</Base>

<style>
  .header {
    padding: 32px 0;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav-name {
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    color: var(--text);
    display: inline-block;
    transition: color 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .nav-name:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 12px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .nav-links a:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .nav-active {
    color: var(--text) !important;
    font-weight: 500;
  }

  /* ── Essay layout ── */
  .essay {
    max-width: 620px;
    padding: 48px 0 80px;
  }

  .essay-header {
    margin-bottom: 48px;
  }

  .back-link {
    display: inline-block;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 24px;
    transition: color 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-2px);
  }

  .essay-title {
    font-family: var(--font-serif);
    font-size: clamp(24px, 5vw, 40px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--text);
  }

  .essay-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 16px;
    font-style: italic;
  }

  .essay-date {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Essay body ── */
  .essay-body {
    font-size: 15px;
    line-height: 1.85;
    color: var(--text);
  }

  .essay-body :global(p) {
    margin-bottom: 1.4em;
  }

  .essay-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .essay-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    margin: 2.5em 0 0.8em;
    color: var(--text);
  }

  .essay-body :global(h3) {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2em 0 0.6em;
  }

  .essay-body :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .essay-body :global(blockquote) {
    border-left: 2px solid var(--border);
    padding-left: 20px;
    margin: 2em 0;
    color: var(--muted);
    font-style: italic;
  }

  .essay-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .essay-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg2);
    padding: 2px 6px;
    border-radius: 3px;
  }

  /* ── Footer ── */
  .essay-footer {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .footer {
    padding: 32px 0;
    font-size: 11px;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 600px) {
    .nav-links {
      gap: 16px;
    }
  }
</style>
