---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sakura from '../components/Sakura.astro';

const allEssays = await getCollection('essays', ({ data }) => !data.draft);
const recentEssays = allEssays
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

function formatDate(date: string): string {
  return new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<Base title="Ilham Maulana Sulaeman" description="Building things I wish existed. Currently exploring how to make everyday tools better.">
  <main class="container">
    <!-- Header -->
    <header class="header reveal">
      <nav class="nav">
        <a href="/" class="nav-name">ilham</a>
        <div class="nav-links">
          <a href="#projects">projects</a>
          <a href="/writings">writings</a>
          <a href="#shapes-me">what shapes me</a>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    <section class="hero">
      <h1 class="hero-name">Ilham Maulana<br/>Sulaeman</h1>

      <p class="hero-tagline">
        Building things I wish existed.<br/>
        Currently exploring how to make everyday tools better.
      </p>

      <p class="hero-bio">
        A life-long learner studying at Bina Nusantara University.
        I build tools, read deeply, and tend a
        <a href="https://second-brain-site-eta.vercel.app/" target="_blank" rel="noopener">second brain</a> where ideas connect.
        Based in Bandung, Indonesia.
      </p>

      <div class="hero-socials">
        <a href="https://github.com/imsulaeman" target="_blank" rel="noopener" title="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/imsulaeman/" target="_blank" rel="noopener" title="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.threads.net/@ulanghidup" target="_blank" rel="noopener" title="Threads">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.59 12c.025 3.083.718 5.496 2.057 7.164 1.432 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.96-.065-1.17.408-2.261 1.333-3.073.862-.755 2.058-1.215 3.456-1.332 1.078-.09 2.076-.022 2.983.178-.109-.728-.369-1.282-.778-1.646-.498-.443-1.242-.673-2.212-.685h-.032c-.834 0-1.882.243-2.476.783l-1.394-1.525C7.516 5.643 9.035 5.2 10.57 5.2h.045c1.401.017 2.532.457 3.361 1.307.766.784 1.237 1.858 1.404 3.188.56.104 1.084.26 1.56.466 1.192.514 2.16 1.346 2.8 2.404.86 1.423.96 3.846-.6 5.442-1.766 1.808-4.022 2.66-7.123 2.687h-.052l.022.006zm-1.36-8.27c-.074 0-.149.003-.224.007-1.63.14-2.527.89-2.48 1.727.023.408.266.956 1.036 1.455.633.41 1.466.585 2.348.536 1.074-.058 1.895-.449 2.442-1.164.355-.462.626-1.074.802-1.842-.867-.308-1.85-.508-2.913-.568-.34-.094-.68-.14-1.011-.151z"/></svg>
        </a>
        <a href="mailto:Imsulaeman@gmail.com" title="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
      </div>

      <Sakura />
    </section>

    <!-- Projects -->
    <section id="projects">
      <div class="section-label reveal">01 projects</div>

      <div class="project-item reveal" style="--delay: 80ms">
        <a href="https://imsulaeman.github.io/Folio" class="project-card" target="_blank" rel="noopener">
          <div class="project-card-header">
            <span class="project-name">Folio</span>
            <span class="project-arrow">↗</span>
          </div>
          <p class="project-desc">
            An offline study companion. Upload PDFs &amp; EPUBs, take rich-text notes,
            text-to-speech, dashboard with reading stats. Single HTML file,
            no server, no account, your data stays on your device.
          </p>
          <div class="project-tags">
            <span>HTML</span>
            <span>CSS</span>
            <span>JavaScript</span>
            <span>PDF.js</span>
            <span>IndexedDB</span>
          </div>
        </a>
      </div>

      <div class="project-item reveal" style="--delay: 160ms">
        <a href="https://second-brain-site-eta.vercel.app/" class="project-card" target="_blank" rel="noopener">
          <div class="project-card-header">
            <span class="project-name">Second Brain</span>
            <span class="project-arrow">↗</span>
          </div>
          <p class="project-desc">
            A personal knowledge base themed as a Memory Palace. Built on an Obsidian
            vault — browse interconnected notes on learning, decision-making, and AI.
            Features a live knowledge graph and full-text fuzzy search.
          </p>
          <div class="project-tags">
            <span>Next.js</span>
            <span>MDX</span>
            <span>D3</span>
            <span>Tailwind</span>
            <span>Fuse.js</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Writings -->
    <section id="writings">
      <div class="section-label reveal">02 writings</div>

      {recentEssays.length === 0 ? (
        <p class="placeholder-text reveal" style="--delay: 80ms">
          Original essays on learning, building, financial and thinking.
        </p>
      ) : (
        <div class="essays-preview">
          {recentEssays.map((essay, i) => (
            <a
              href={`/writings/${essay.id}`}
              class="essay-row reveal"
              style={`--delay: ${i * 60}ms`}
            >
              <time class="essay-date">{formatDate(essay.data.date)}</time>
              <span class="essay-title">{essay.data.title}</span>
              <span class="essay-arrow-sm">→</span>
            </a>
          ))}
          <a href="/writings" class="view-all reveal" style={`--delay: ${recentEssays.length * 60}ms`}>
            view all writings →
          </a>
        </div>
      )}
    </section>

    <!-- What Shapes Me -->
    <section id="shapes-me">
      <div class="section-label reveal">03 what shapes me</div>

      <div class="influence-item reveal" style="--delay: 0ms">
        <span class="influence-title"><a href="https://www.amazon.com/Atomic-Habits-Proven-Build-Break/dp/0735211299" target="_blank" rel="noopener noreferrer">Atomic Habits</a></span>
        <p class="influence-desc">
          James Clear on the system behind behavior change. Small habits compound —
          identity shapes action, action shapes identity. The book that made me
          think in systems instead of goals.
        </p>
      </div>

      <div class="influence-item reveal" style="--delay: 160ms">
        <span class="influence-title"><a href="https://www.amazon.com/most-important-thing-Howard-Marks/dp/9353022797" target="_blank" rel="noopener noreferrer">The Most Important Thing</a></span>
        <p class="influence-desc">
          Thinking past the obvious. Every action has consequences,
          and those consequences have consequences. The foundation
          of good judgment under uncertainty.
        </p>
      </div>

      <div class="influence-item reveal" style="--delay: 240ms">
        <span class="influence-title"><a href="https://www.navalmanack.com/almanack-of-naval-ravikant/table-of-contents" target="_blank" rel="noopener noreferrer">The Almanack of Naval Ravikant</a></span>
        <p class="influence-desc">
          How I learned to value leverage — maybe I didn't realize it but I've been
          applying it in my life for a while. Leverage is the force multiplier of
          effort, and the key to scale.
        </p>
      </div>

      <p class="garden-cta reveal" style="--delay: 320ms">
        These ideas live in my <a href="https://second-brain-site-eta.vercel.app/" target="_blank" rel="noopener noreferrer">second brain</a> —
        a growing collection of concepts, sources, and synthesis.
      </p>
    </section>

    <!-- Contact -->
    <section class="contact">
      <div class="section-label reveal">contact</div>

      <p class="contact-text reveal" style="--delay: 80ms">
        If you'd like to talk, feel free to reach out.
        I'd love to hear from you.
      </p>

      <a href="mailto:Imsulaeman@gmail.com" class="contact-email reveal" style="--delay: 160ms">
        Imsulaeman@gmail.com
      </a>
    </section>

    <footer class="footer reveal">
      <p>&copy; 2026 Ilham Maulana Sulaeman</p>
    </footer>
  </main>
</Base>

<style>
  /* ── Header / Nav ── */
  .header {
    padding: 32px 0;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .nav-name {
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    color: var(--text);
    display: inline-block;
    transition: color var(--duration-base), transform var(--duration-base) var(--ease-out-expo);
  }

  .nav-name:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .nav-links {
    display: flex;
    gap: 24px;
    font-size: 12px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    transition: color var(--duration-base), transform var(--duration-base) var(--ease-out-expo);
  }

  .nav-links a:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  /* ── Hero ── */
  .hero {
    padding: 60px 0 0;
  }

  .hero-name {
    font-family: var(--font-serif);
    font-size: clamp(28px, 6vw, 48px);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: 28px;
    color: var(--text);
  }

  .hero-tagline {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 20px;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  .hero-bio {
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 28px;
    max-width: 480px;
    color: var(--text);
  }

  .hero-socials {
    display: flex;
    gap: 16px;
    margin-bottom: 8px;
  }

  .hero-socials a {
    color: var(--muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color var(--duration-base), transform var(--duration-fast) var(--ease-out-expo);
  }

  .hero-socials a:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .hero-socials a:active {
    transform: scale(0.97);
  }

  /* ── Project cards ── */
  .project-item {
    margin-bottom: 16px;
  }

  .project-card {
    display: block;
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.25s var(--ease-out-expo),
      box-shadow 0.25s var(--ease-out-expo),
      border-color 0.2s;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px -8px rgba(44, 36, 32, 0.12);
    border-color: var(--accent2);
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .project-name {
    font-size: 15px;
    font-weight: 600;
  }

  .project-arrow {
    font-size: 16px;
    color: var(--muted);
    transition: transform 0.2s var(--ease-out-expo), color 0.2s;
  }

  .project-card:hover .project-arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }

  .project-desc {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-tags span {
    font-size: 10px;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--muted);
    background: var(--bg2);
  }

  /* ── Writings section ── */
  .placeholder-text {
    color: var(--muted);
    font-size: 13px;
    font-style: italic;
  }

  .essays-preview {
    display: flex;
    flex-direction: column;
  }

  .essay-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }

  .essay-row:first-child {
    border-top: 1px solid var(--border);
  }

  .essay-date {
    font-size: 11px;
    color: var(--muted);
    flex-shrink: 0;
    width: 110px;
    letter-spacing: 0.02em;
  }

  .essay-title {
    flex: 1;
    font-size: 13px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .essay-arrow-sm {
    font-size: 13px;
    color: var(--muted);
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-out-expo), color 0.2s;
  }

  .essay-row:hover .essay-title {
    color: var(--accent);
  }

  .essay-row:hover .essay-arrow-sm {
    transform: translateX(3px);
    color: var(--accent);
  }

  .view-all {
    display: inline-block;
    margin-top: 20px;
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s, transform 0.2s var(--ease-out-expo);
  }

  .view-all:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* ── What Shapes Me ── */
  .influence-item {
    margin-bottom: 28px;
  }

  .influence-title {
    font-size: 14px;
    font-weight: 600;
    display: inline-block;
  }

  .influence-title a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
    transition: color var(--duration-base), text-decoration-color var(--duration-base);
  }

  .influence-title a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .influence-desc {
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .garden-cta {
    margin-top: 32px;
    font-size: 13px;
    color: var(--muted);
    font-style: italic;
  }

  /* ── Contact ── */
  .contact-text {
    font-size: 13px;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .contact-email {
    font-size: 14px;
    font-weight: 500;
  }

  /* ── Footer ── */
  .footer {
    padding: 48px 0 32px;
    font-size: 11px;
    color: var(--muted);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .hero-name {
      font-size: clamp(24px, 8vw, 32px);
    }

    .nav-links {
      gap: 16px;
    }

    .essay-date {
      display: none;
    }

    .project-card {
      padding: 16px 18px;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
  );

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
