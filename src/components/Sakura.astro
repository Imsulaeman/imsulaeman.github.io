---
// Interactive reading container — floating sakura petals, shake on click
---

<div class="globe-outer" id="globe-outer" role="button" aria-label="Click to shake" tabindex="0">
  <div class="globe-container" id="globe-container">
    <div class="frame-stack">
      <img src="/assets/loop/frames 1.png" alt="" class="frame active" aria-hidden="true" />
      <img src="/assets/loop/frames 2.png" alt="" class="frame"        aria-hidden="true" />
      <img src="/assets/loop/frames 3.png" alt="" class="frame"        aria-hidden="true" />
    </div>
    <canvas class="petal-canvas" id="petal-canvas" aria-hidden="true"></canvas>
  </div>
  <p class="globe-hint">click to shake</p>
</div>

<style>
  .globe-outer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin: 48px 0 8px;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .globe-container {
    position: relative;
    width: 100%;
    max-width: 480px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow:
      0 2px 8px -2px rgba(44, 36, 32, 0.06),
      0 8px 32px -8px rgba(44, 36, 32, 0.08);
    transition: box-shadow 0.3s var(--ease-out-expo);
  }

  .globe-outer:hover .globe-container {
    box-shadow:
      0 4px 16px -4px rgba(44, 36, 32, 0.1),
      0 16px 48px -12px rgba(44, 36, 32, 0.12);
  }

  .globe-container.shaking {
    animation: globe-shake 0.55s var(--ease-out-expo);
  }

  .frame-stack {
    position: relative;
    width: 100%;
    display: block;
  }

  .frame {
    width: 100%;
    height: auto;
    display: block;
    position: absolute;
    top: 0; left: 0;
    opacity: 0;
  }

  .frame:first-child {
    position: relative;
  }

  .frame.active {
    opacity: 1;
  }

  .petal-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .globe-hint {
    margin-top: 8px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-family: var(--font-mono);
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .globe-outer:hover .globe-hint {
    opacity: 1;
  }

  @keyframes globe-shake {
    0%   { transform: translateX(0)    rotate(0deg); }
    12%  { transform: translateX(-7px) rotate(-1.2deg); }
    24%  { transform: translateX(6px)  rotate(1deg); }
    36%  { transform: translateX(-5px) rotate(-0.8deg); }
    48%  { transform: translateX(4px)  rotate(0.6deg); }
    62%  { transform: translateX(-2px) rotate(-0.3deg); }
    76%  { transform: translateX(1px)  rotate(0.1deg); }
    100% { transform: translateX(0)    rotate(0deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-container.shaking { animation: none; }
    .petal-canvas { display: none; }
    .globe-hint { display: none; }
  }

  @media (max-width: 600px) {
    .globe-container { max-width: 100%; }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    const outer     = document.getElementById('globe-outer')!;
    const container = document.getElementById('globe-container')!;
    const canvas    = document.getElementById('petal-canvas') as HTMLCanvasElement;
    const frames    = Array.from(container.querySelectorAll<HTMLImageElement>('.frame'));

    let frameIdx = 0;

    function setFrame(i: number) {
      frames[frameIdx].classList.remove('active');
      frameIdx = i;
      frames[frameIdx].classList.add('active');
    }
    const ctx       = canvas.getContext('2d')!;

    const COLORS = ['#ffc0cb', '#ffb7c5', '#f4a7b9', '#f8d0d8', '#ffe0e8'];

    interface Petal {
      x: number; y: number;
      vx: number; vy: number;
      baseVy: number;
      wobble: number; wobbleSpeed: number;
      size: number; color: string;
      opacity: number; rotation: number; rotSpeed: number;
    }

    let petals: Petal[] = [];
    let W = 0, H = 0;
    let rafId = 0;

    function resize() {
      const r = container.getBoundingClientRect();
      W = r.width;
      H = r.height;
      canvas.width  = W;
      canvas.height = H;
    }

    function makePetal(burst = false): Petal {
      return {
        x:           burst ? W * 0.2 + Math.random() * W * 0.6 : Math.random() * W,
        y:           burst ? H * 0.2 + (Math.random() - 0.5) * H * 0.5 : -8,
        vx:          (Math.random() - 0.5) * (burst ? 5 : 0.4),
        vy:          burst ? (Math.random() - 0.5) * 5 : 0.35 + Math.random() * 0.45,
        baseVy:      0.35 + Math.random() * 0.45,
        wobble:      Math.random() * Math.PI * 2,
        wobbleSpeed: 0.012 + Math.random() * 0.018,
        size:        2.5 + Math.random() * 3,
        color:       COLORS[Math.floor(Math.random() * COLORS.length)],
        opacity:     0.45 + Math.random() * 0.4,
        rotation:    Math.random() * Math.PI * 2,
        rotSpeed:    (Math.random() - 0.5) * 0.04,
      };
    }

    function drawPetal(p: Petal) {
      ctx.save();
      ctx.globalAlpha = Math.max(0, p.opacity);
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function tick() {
      ctx.clearRect(0, 0, W, H);

      if (petals.length < 22) petals.push(makePetal());

      for (let i = petals.length - 1; i >= 0; i--) {
        const p = petals[i];
        p.wobble += p.wobbleSpeed;
        p.x += p.vx + Math.sin(p.wobble) * 0.5;
        p.y += p.vy;
        p.rotation += p.rotSpeed;

        p.vx *= 0.96;
        p.vy  = p.vy * 0.96 + p.baseVy * 0.04;

        if (p.y > H * 0.75) p.opacity -= 0.015;

        if (p.y > H + 8 || p.x < -16 || p.x > W + 16 || p.opacity <= 0) {
          petals.splice(i, 1);
          continue;
        }
        drawPetal(p);
      }

      rafId = requestAnimationFrame(tick);
    }

    let cycleStep = 0;
    let intervalId = 0;

    function shake() {
      container.classList.remove('shaking');
      void container.offsetWidth;
      container.classList.add('shaking');

      clearInterval(intervalId);
      cycleStep = 0;
      intervalId = window.setInterval(() => {
        setFrame(cycleStep === 0 ? 1 : 2);
        cycleStep = cycleStep === 0 ? 1 : 0;
      }, 80);

      container.addEventListener('animationend', () => {
        container.classList.remove('shaking');
        clearInterval(intervalId);
        setFrame(0);
      }, { once: true });

      petals.forEach(p => {
        p.vx += (Math.random() - 0.5) * 7;
        p.vy += (Math.random() - 0.7) * 5;
        p.opacity = Math.min(1, p.opacity + 0.3);
      });
      for (let i = 0; i < 10; i++) petals.push(makePetal(true));
    }

    resize();
    tick();

    outer.addEventListener('click', shake);
    outer.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') shake(); });

    const ro = new ResizeObserver(resize);
    ro.observe(container);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
      ro.disconnect();
    }, { once: true });
  }
</script>
